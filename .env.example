# 발주페이지 서버 환경변수
# Vercel → luckyspot-shop → Settings → Environment Variables 에 같은 이름으로 넣는다.
# 실제 값은 절대 커밋하지 않는다 (이 파일은 이름만 적는 예시).

# 1) 주문 전달 (Google Apps Script 웹훅) — 기존 원본 경로. 없으면 주문 접수 불가
GAS_WEBHOOK_URL=
GAS_SECRET=

# 2) 주문 사본 적재 (Supabase shop_orders) — 없거나 테이블이 없으면 경고 로그만 남기고 주문은 정상 접수
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 3) 발주 완료 안내 (SOLAPI) — 없거나 실패해도 주문 접수는 정상 처리(경고 로그만)
#   알림톡(message:send-ata)은 허용 IP 등록이 필요 없어 Vercel에서도 발송된다.
#   문자(SMS/LMS)는 전송자격인증제 때문에 발송 키에 고정 공인 IP를 등록해야 한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_PFID=
SOLAPI_ORDER_TEMPLATE_ID=

# 3-2) 발주 상태 알림(/admin/orders 에서 본사승인·출고완료로 바꿀 때 점주에게 알림톡)
#   템플릿 변수: #{지점명} #{주문번호} #{상태} — 카카오 채널에 이 변수로 템플릿을 등록해야 합니다.
#   값이 없으면 조용히 건너뛰고 상태 변경은 정상 처리됩니다.
SOLAPI_ALIMTALK_TEMPLATE_ORDER_STATUS=

# 3-1) 본사(대표) 즉시 알림 — 알림톡 → 이메일 릴레이 → 문자 순으로 시도
ADMIN_ALERT_PHONE=
SOLAPI_ADMIN_ORDER_TEMPLATE_ID=
SOLAPI_ADMIN_TEMPLATE_ID=
ADMIN_ALERT_EMAIL_URL=
ADMIN_ALERT_EMAIL_SECRET=
ADMIN_ALERT_EMAIL_TO=
SOLAPI_SMS_ALERTS=off

# 4) 본사 발주 관리자 (/admin/orders) — 두 값이 없으면 로그인 자체가 막힌다(fail-closed).
#   비밀번호는 6~12자리 숫자, 서명 키는 16자 이상 임의 문자열.
#   값을 바꾸면 기존 로그인 쿠키는 자동으로 무효가 된다.
SHOP_ADMIN_PASSCODE=
SHOP_ADMIN_COOKIE_SECRET=

# 5) 토스페이먼츠 결제 (카드 · 계좌이체 · 가상계좌)
#   · 두 값이 모두 없으면 공식 테스트 키로 "테스트 결제 모드"로 동작한다(실제 금액 청구 없음,
#     알림톡·구글시트 전달도 하지 않음). 실사업자 키를 넣으면 그대로 실결제가 된다.
#   · 클라이언트 키: live_gck_… / test_gck_…  (브라우저에 노출되는 공개 값)
#   · 시크릿 키:   live_gsk_… / test_gsk_…  (서버 전용 — 절대 커밋·노출 금지)
#   · 하나만 넣으면 설정이 반쪽이라 결제가 열리지 않는다(의도된 fail-closed).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 5-1) 결제 의도 토큰 서명 키(선택) — 비우면 TOSS_SECRET_KEY 로 서명한다.
#      결제 승인 때 "주문 준비 때와 같은 품목·금액인지" 확인하는 서명에 쓰는 임의 문자열(32자 이상 권장).
PAYMENT_TOKEN_SECRET=

# 5-2) 테스트 결제에서도 알림톡·구글시트 전달을 하고 싶을 때만 1
TOSS_TEST_SUPPRESS_NOTIFICATIONS=

