# 발주페이지 서버 환경변수
# Vercel → luckyspot-shop → Settings → Environment Variables 에 같은 이름으로 넣는다.
# 실제 값은 절대 커밋하지 않는다 (이 파일은 이름만 적는 예시).

# 1) 주문 전달 (Google Apps Script 웹훅) — 기존 원본 경로. 없으면 주문 접수 불가
GAS_WEBHOOK_URL=
GAS_SECRET=

# 2) 주문 사본 적재 (Supabase shop_orders) — 없거나 테이블이 없으면 경고 로그만 남기고 주문은 정상 접수
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
